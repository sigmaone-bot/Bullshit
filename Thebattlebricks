		end
		-- detectar nuevos
		grenadeConn = projectileFolder.DescendantAdded:Connect(removeCollision)
	else
		if grenadeConn then grenadeConn:Disconnect() end
	end
	
	antiGrenadeBtn.Text = grenadeEnabled and "Anti X-TREME grenades: ON" or "Anti X-TREME grenades: OFF"
	antiGrenadeBtn.BackgroundColor3 = grenadeEnabled and Color3.fromRGB(255,120,120) or Color3.fromRGB(45,45,45)
