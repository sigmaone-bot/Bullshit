	local function clearList()
		for _,v in ipairs(list:GetChildren()) do
			if v:IsA("TextButton") then
				v:Destroy()
			end
		end
	end

	local function setHighlight(model)

		if currentHighlight and currentHighlight.Parent then
			currentHighlight:Destroy()
		end

		if model and model.Parent then

			local h = Instance.new("Highlight")

			h.FillColor = Color3.fromRGB(255,120,120)
			h.FillTransparency = 0.85

			h.OutlineColor = Color3.fromRGB(255,0,0)
			h.OutlineTransparency = 0.25

			h.Parent = model

			currentHighlight = h
		end
	end

	local function refreshList()

		clearList()

		for _,v in ipairs(enemyFolder:GetChildren()) do

			local b = Instance.new("TextButton")

			b.Size = UDim2.new(1,-10,0,45)

			b.Text = v.Name
			b.BackgroundColor3 = Color3.fromRGB(50,50,50)
			b.TextColor3 = Color3.new(1,1,1)

			b.Parent = list

			Instance.new("UICorner", b)

			b.MouseButton1Click:Connect(function()
				setHighlight(v)
				targetName = v.Name
				box.Text = v.Name
			end)
		end
	end

	enemyFolder.ChildAdded:Connect(refreshList)
	enemyFolder.ChildRemoved:Connect(refreshList)

	refreshList()

	-- TARGET SYSTEM
	local function getTarget()

		local t = enemyFolder:FindFirstChild(targetName)

		if not t then
			return nil
		end

		if t:IsA("Model") then
			return t:FindFirstChild("HumanoidRootPart")
		elseif t:IsA("BasePart") then
			return t
		end

		return nil
	end

	local function getSuperballTarget()

		local t = enemyFolder:FindFirstChild(superballTargetName)

		if not t then
			return nil
		end

		if t:IsA("Model") then
			return t:FindFirstChild("HumanoidRootPart")
		elseif t:IsA("BasePart") then
			return t
		end

		return nil
	end

	local function follow(part)

		if active[part] then
			return
		end

		active[part] = true

		task.spawn(function()

			while targetEnabled and part and part.Parent do

				local t = getTarget()

				if t and t.Parent and part and part.Parent then
					part.CFrame = t.CFrame
				end

				RunService.Heartbeat:Wait()
			end

			active[part] = nil
		end)
	end

	local function followSuperball(part)

		if active[part] then
			return
		end

		active[part] = true

		task.spawn(function()

			while superballTargetEnabled and part and part.Parent do

				local t = getSuperballTarget()

				if t and t.Parent and part and part.Parent then
					part.CFrame = t.CFrame
				end

				RunService.Heartbeat:Wait()
			end

			active[part] = nil
		end)
	end

	-- BASE TARGET SYSTEM
	local function followBase(part)

		if active[part] then
			return
		end

		active[part] = true

		task.spawn(function()

			while baseTargetEnabled and part and part.Parent do

				local redBase =
					npcFolders
					:FindFirstChild("BaseFolder")

				if redBase then
					local redBaseSpawn =
						redBase:FindFirstChild("Red Base")

					if redBaseSpawn then
						local spawn =
							redBaseSpawn:FindFirstChild("Spawn")

						if spawn and part and part.Parent then
							part.CFrame = spawn.CFrame
						end
					end
				end

				RunService.Heartbeat:Wait()
			end

			active[part] = nil
		end)
	end

	local function followSuperballBase(part)

		if active[part] then
			return
		end

		active[part] = true

		task.spawn(function()

			while superballBaseTargetEnabled and part and part.Parent do

				local redBase =
					npcFolders
					:FindFirstChild("BaseFolder")

				if redBase then
					local redBaseSpawn =
						redBase:FindFirstChild("Red Base")

					if redBaseSpawn then
						local spawn =
							redBaseSpawn:FindFirstChild("Spawn")

						if spawn and part and part.Parent then
							part.CFrame = spawn.CFrame
						end
					end
				end

				RunService.Heartbeat:Wait()
			end

			active[part] = nil
		end)
	end

	projectileFolder.DescendantAdded:Connect(function(obj)

		if targetEnabled and not baseTargetEnabled then

			if obj.Name == "Teapot"
			or obj.Name == "FireTeapot" then

				task.defer(function()
					follow(obj)
				end)
			end
		elseif baseTargetEnabled and not targetEnabled then

			if obj.Name == "Teapot"
			or obj.Name == "FireTeapot" then

				task.defer(function()
					followBase(obj)
				end)
			end
		elseif superballTargetEnabled and not superballBaseTargetEnabled then

			if obj.Name == "Superball"
			or obj.Name == "Soccerball" then

				task.defer(function()
					followSuperball(obj)
				end)
			end
		elseif superballBaseTargetEnabled and not superballTargetEnabled then

			if obj.Name == "Superball"
			or obj.Name == "Soccerball" then

				task.defer(function()
					followSuperballBase(obj)
				end)
			end
		end
	end)

	targetToggle.MouseButton1Click:Connect(function()

		targetEnabled = not targetEnabled

		if targetEnabled and baseTargetEnabled then
			baseTargetEnabled = false
			baseTargetToggle.Text = "Target Base: OFF"
			baseTargetToggle.BackgroundColor3 = Color3.fromRGB(45,45,45)
			if baseTargetConn then
				baseTargetConn:Disconnect()
				baseTargetConn = nil
			end
		end

		targetToggle.Text =
			targetEnabled and "Target: ON" or "Target: OFF"

		targetToggle.BackgroundColor3 =
			targetEnabled
			and Color3.fromRGB(120,80,255)
			or Color3.fromRGB(45,45,45)
	end)

	baseTargetToggle.MouseButton1Click:Connect(function()

		baseTargetEnabled = not baseTargetEnabled

