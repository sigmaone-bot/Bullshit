-- TARGET SYSTEM
local function getTarget()
	local t = enemyFolder:FindFirstChild(targetName)

	if not t then
		return nil
	end

	if t:IsA("Model") then
		return t:FindFirstChild("HumanoidRootPart")
	elseif t:IsA("BasePart") then
		return t
	end

	return nil
end

local function follow(part)
	if active[part] then
		return
	end

	active[part] = true

	task.spawn(function()
		while targetEnabled and part and part.Parent do
			local t = getTarget()

			if t and t.Parent and part and part.Parent then
				part.CFrame = t.CFrame
			end

			RunService.Heartbeat:Wait()
		end

		active[part] = nil
	end)
end

projectileFolder.DescendantAdded:Connect(function(obj)
	if targetEnabled then
		if obj.Name == "Teapot" or obj.Name == "FireTeapot" then
			task.defer(function()
				follow(obj)
			end)
		end
	end
end)

