	end)

	superballBaseTargetToggle.MouseButton1Click:Connect(function()

		superballBaseTargetEnabled = not superballBaseTargetEnabled

		if superballBaseTargetEnabled and superballTargetEnabled then
			superballTargetEnabled = false
			superballTargetToggle.Text = "Target: OFF"
			superballTargetToggle.BackgroundColor3 = Color3.fromRGB(45,45,45)
		end

		superballBaseTargetToggle.Text =
			superballBaseTargetEnabled and "Target Base: ON" or "Target Base: OFF"

		superballBaseTargetToggle.BackgroundColor3 =
			superballBaseTargetEnabled
