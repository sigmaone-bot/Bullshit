	-- ANTI NEWELL
	local antiBtn = makeButton(
		antis,
		"Anti Newell: OFF",
		UDim2.new(0.05,0,0.1,0)
	)

	local function applyAnti(obj)

		if obj:IsA("BasePart") then

			if obj.Name == "Teapot"
			or obj.Name == "FireTeapot" then

				obj.Anchored = true
			end
		end
	end

	antiBtn.MouseButton1Click:Connect(function()

		antiEnabled = not antiEnabled

		if antiEnabled then

			for _,v in ipairs(projectileFolder:GetDescendants()) do
				applyAnti(v)
			end

			antiConn =
				projectileFolder.DescendantAdded:Connect(applyAnti)

		else

			if antiConn then
				antiConn:Disconnect()
				antiConn = nil
			end
		end

		antiBtn.Text =
			antiEnabled
			and "Anti Newell: ON"
			or "Anti Newell: OFF"

		antiBtn.BackgroundColor3 =
			antiEnabled
			and Color3.fromRGB(70,130,255)
			or Color3.fromRGB(45,45,45)
	end)

	-- ANTI GRENADES
	local antiGrenadeBtn = makeButton(
		antis,
		"Anti X-TREME grenades: OFF",
		UDim2.new(0.37,0,0.1,0)
	)

	local function removeCollision(obj)

		if obj:IsA("MeshPart")
		and obj.Name == "Execnade" then

			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
		end
	end

	antiGrenadeBtn.MouseButton1Click:Connect(function()

		grenadeEnabled = not grenadeEnabled

		if grenadeEnabled then

			for _,v in ipairs(projectileFolder:GetDescendants()) do
				removeCollision(v)
			end

			grenadeConn =
				projectileFolder.DescendantAdded:Connect(
					removeCollision
				)

		else

			if grenadeConn then
				grenadeConn:Disconnect()
				grenadeConn = nil
			end
		end

		antiGrenadeBtn.Text =
			grenadeEnabled
			and "Anti X-TREME grenades: ON"
			or "Anti X-TREME grenades: OFF"

		antiGrenadeBtn.BackgroundColor3 =
			grenadeEnabled
			and Color3.fromRGB(255,120,120)
			or Color3.fromRGB(45,45,45)
	end)

	local tableToggle = makeButton(
		antis,
		"Table: OFF",
		UDim2.new(0.69,0,0.1,0)
	)


	local function trackBAV(bav)
		if bav and bav:IsA("BodyAngularVelocity") then
			bodyAngularList[bav] = true
		end
	end

	local function removeTouchInterest(descendant)
		if descendant and descendant:IsA("TouchInterest") then
			descendant:Destroy()
		end
	end

	local function HandleTable(tablePart)

		if not tablePart:IsA("BasePart") then
			return
		end

		local blueSpawn =
			npcFolders
			:WaitForChild("BaseFolder")
			:WaitForChild("Blue Base")
			:WaitForChild("Spawn")

		tablePart.CFrame =
			blueSpawn.CFrame * CFrame.new(0,-1,0)

		tablePart.Size =
			tablePart.Size * 200

		tablePart.CustomPhysicalProperties =
			PhysicalProperties.new(
				0.7,
				0.3,
				0.5
			)

		local bav =
			tablePart:FindFirstChildOfClass(
				"BodyAngularVelocity"
			)

		if not bav then

			bav = Instance.new("BodyAngularVelocity")

			bav.Name = "Spin"

			bav.MaxTorque =
				Vector3.new(1e6,1e6,1e6)

			bav.AngularVelocity =
				Vector3.new(-40,0,0)

			bav.Parent = tablePart
		end

		trackBAV(bav)

		for _,desc in ipairs(
			tablePart:GetDescendants()
		) do
			removeTouchInterest(desc)
		end
	end

	tableToggle.MouseButton1Click:Connect(function()

		tableEnabled = not tableEnabled

		if tableEnabled then

			for _,obj in ipairs(
				projectileFolder:GetChildren()
			) do

				if obj.Name == "Table" then
					HandleTable(obj)
				end
			end

			tableConnections.added =
				projectileFolder.ChildAdded:Connect(
					function(child)

						if child.Name == "Table" then
							HandleTable(child)
						end
					end
				)

			tableConnections.heartbeat =
				RunService.Heartbeat:Connect(function()

					for bav,_ in pairs(bodyAngularList) do

						if bav and bav.Parent then

							bav.AngularVelocity =
								Vector3.new(-40,0,0)

						else
							bodyAngularList[bav] = nil
						end
					end
				end)

		else

			for _,conn in pairs(tableConnections) do
				if conn then
					conn:Disconnect()
				end
			end

			tableConnections = {}

			for bav,_ in pairs(bodyAngularList) do
				if bav then
					bav:Destroy()
				end
			end

			table.clear(bodyAngularList)
		end

		tableToggle.Text =
			tableEnabled
			and "Table: ON"
			or "Table: OFF"

		tableToggle.BackgroundColor3 =
			tableEnabled
			and Color3.fromRGB(255,170,0)
			or Color3.fromRGB(45,45,45)
	end)

	-- TABS
	tabEditor.MouseButton1Click:Connect(function()

		editor.Visible = true
		antis.Visible = false
		detector.Visible = false
	end)

	tabAntis.MouseButton1Click:Connect(function()

		editor.Visible = false
		antis.Visible = true
		detector.Visible = false
	end)

	tabDetector.MouseButton1Click:Connect(function()

		editor.Visible = false
		antis.Visible = false
		detector.Visible = true
	end)

end

