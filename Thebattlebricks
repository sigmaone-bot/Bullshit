-- TABLE
local tableToggle = makeButton(
	antis,
	"Table: OFF",
	UDim2.new(0.07,0,0.36,0)
)

local function trackBAV(bav)
	if bav and bav:IsA("BodyAngularVelocity") then
		bodyAngularList[bav] = true
	end
end

local function removeTouchInterest(desc)
	if desc and desc:IsA("TouchInterest") then
		desc:Destroy()
	end
end

local function HandleTable(tablePart)
	if not tableEnabled then
		return
	end

	if not tablePart then
		return
	end

	if not tablePart:IsA("BasePart") then
		return
	end

	if activeTables[tablePart] then
		return
	end

	activeTables[tablePart] = true

	local npcFolders = Workspace:FindFirstChild("NPCFolders")
	if not npcFolders then return end

	local baseFolder = npcFolders:FindFirstChild("BaseFolder")
	if not baseFolder then return end

	local blueBase = baseFolder:FindFirstChild("Blue Base")
	if not blueBase then return end

	local spawnPart = blueBase:FindFirstChild("Spawn")
	if not spawnPart then return end

	local spawnCF = spawnPart.CFrame * CFrame.new(0,-1,0)

	tablePart.Anchored = false
	tablePart.CanCollide = true
	tablePart.Massless = false

	tablePart.CFrame = spawnCF

	tablePart.AssemblyLinearVelocity = Vector3.zero
	tablePart.AssemblyAngularVelocity = Vector3.zero

	if not tablePart:GetAttribute("Scaled") then
		tablePart:SetAttribute("Scaled", true)

		if tablePart.Size.Magnitude < 500 then
			tablePart.Size *= 150
		end
	end

	tablePart.CustomPhysicalProperties =
		PhysicalProperties.new(
			10,
			0.3,
			0.5
		)

	for _,v in ipairs(tablePart:GetDescendants()) do
		if v:IsA("BodyPosition")
		or v:IsA("BodyVelocity")
		or v:IsA("LinearVelocity")
		or v:IsA("VectorForce")
		or v:IsA("Torque") then
			v:Destroy()
		end
	end

	local bav =
		tablePart:FindFirstChildOfClass("BodyAngularVelocity")

	if not bav then
		bav = Instance.new("BodyAngularVelocity")
		bav.Name = "Spin"
		bav.Parent = tablePart
	end

	bav.MaxTorque = Vector3.new(50000,0,0)
	bav.P = 3000
	bav.AngularVelocity = Vector3.new(-20,0,0)

	trackBAV(bav)

	for _,desc in ipairs(tablePart:GetDescendants()) do
		removeTouchInterest(desc)
	end

	activeTables[tablePart] = spawnCF
end

local function startTableLoop()
	if tableLoopRunning then
		return
	end

	tableLoopRunning = true

	tableConnections.loop =
		RunService.Heartbeat:Connect(function()

			for tablePart,spawnCF in pairs(activeTables) do

				if not tableEnabled
				or not tablePart
				or not tablePart.Parent then

					activeTables[tablePart] = nil

				else
					tablePart.CFrame = spawnCF
					tablePart.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end)
end

tableToggle.MouseButton1Click:Connect(function()

	tableEnabled = not tableEnabled

	if tableEnabled then

		startTableLoop()

		for _,obj in ipairs(projectileFolder:GetChildren()) do
			if obj.Name == "Table" then
				task.spawn(function()
					HandleTable(obj)
				end)
			end
		end

		tableConnections.added =
			projectileFolder.ChildAdded:Connect(function(obj)

				if obj.Name == "Table" then
					task.spawn(function()
						HandleTable(obj)
					end)
				end
			end)

	else

		for _,conn in pairs(tableConnections) do
			if conn then
				conn:Disconnect()
			end
		end

		tableConnections = {}

		tableLoopRunning = false

		for bav,_ in pairs(bodyAngularList) do
			if bav then
				bav:Destroy()
			end
		end

		for k in pairs(bodyAngularList) do
			bodyAngularList[k] = nil
		end

		for k in pairs(activeTables) do
			activeTables[k] = nil
		end
	end

	tableToggle.Text =
		tableEnabled and "Table: ON" or "Table: OFF"

	tableToggle.BackgroundColor3 =
		tableEnabled
		and Color3.fromRGB(255,170,0)
		or Color3.fromRGB(45,45,45)
end)

